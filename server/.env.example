# Copy this file to .env and fill in real values before deploying.

# PostgreSQL connection — required, no default. Local dev example:
#   postgresql://triocraft:password@localhost:5432/triocraft
# Production (see README-DEPLOY.md step 1 for creating this role/database):
#   postgresql://triocraft:REAL_PASSWORD@localhost:5432/triocraft
# Use sslmode=require in the query string if your Postgres requires TLS
# (not needed for the default local-socket setup in README-DEPLOY.md, since
# the app and database run on the same VPS).
DATABASE_URL=postgresql://triocraft:password@localhost:5432/triocraft

# 4000 — this is the internal API port Nginx proxies /api and /uploads to.
# The Next.js frontend (../web) runs separately on port 3000 (its own
# default via `next start`) — see README-DEPLOY.md for the full topology.
PORT=4000
SESSION_SECRET=change-this-to-a-long-random-string
NODE_ENV=production

# Email notifications (contact form + new orders/briefs) — optional.
# Leave blank and the app logs the email to the console instead of sending.
# Works with Gmail (use an App Password, not your normal password), SendGrid,
# Mailgun SMTP, or your own host's SMTP relay.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="TrioCraft Website" <no-reply@triocraft.org>
NOTIFY_EMAIL=triocraft.brands@gmail.com

# Used to build WhatsApp "chat with us" / deep-link buttons (digits only,
# country code, no +). Defaults to the client's confirmed sitewide number
# (+254 111 206 420) if left blank — see lib/site-config.js; override here
# if WhatsApp should run on a different number.
WHATSAPP_NUMBER=254111206420

# WhatsApp Cloud API (Meta) — optional. Powers AUTOMATED status-update
# messages (order status changes, invoices issued, payments confirmed).
# Leave blank and these log a simulated send to the console instead — the
# "wa.me" deep-link buttons (cart/brief/order) work with zero setup either
# way, since those don't need this API at all.
# Set up at https://developers.facebook.com/docs/whatsapp/cloud-api/get-started
WHATSAPP_CLOUD_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_GRAPH_API_VERSION=v20.0

# AI-assisted brief structuring (see lib/ai-brief.js) — optional. Leave blank
# and "AI Assist" on the Custom Brief form falls back to a keyword/regex
# heuristic instead of calling the real Claude API. Get a key at
# https://console.anthropic.com
ANTHROPIC_API_KEY=
ANTHROPIC_BRIEF_MODEL=claude-3-5-haiku-20241022

# KRA e-TIMS fiscal invoicing (see lib/etims.js) — optional, and NOT a
# drop-in like the others: e-TIMS has no single public sandbox API. Leave
# blank and invoicing simulates a fiscal receipt number so the invoicing
# workflow is fully testable. Point these at your KRA-approved VSCU/
# middleware provider's endpoint once you have one.
ETIMS_API_URL=
ETIMS_API_KEY=

# MTN Mobile Money (Uganda) — optional. Leave blank and regional mobile
# money payments simulate a push. Get sandbox keys at
# https://momodeveloper.mtn.com ("Collections" product).
MOMO_ENV=sandbox
MOMO_SUBSCRIPTION_KEY=
MOMO_API_USER=
MOMO_API_KEY=

# Airtel Money (Tanzania / Rwanda) — optional, same graceful fallback.
# Get sandbox keys at https://developers.airtel.africa ("Collection" API).
AIRTEL_ENV=sandbox
AIRTEL_CLIENT_ID=
AIRTEL_CLIENT_SECRET=

# M-Pesa Daraja 2.0 (STK Push) — optional. Leave blank and "Pay with M-Pesa"
# simulates a push (logs to console) instead of calling Safaricom, so
# checkout still works end-to-end in dev without real credentials.
# Get sandbox keys at https://developer.safaricom.co.ke (create an app under
# "Lipa Na M-Pesa Online").
MPESA_ENV=sandbox
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=174379
MPESA_PASSKEY=
# Must be a publicly reachable HTTPS URL — Safaricom cannot call localhost.
# Use ngrok in dev (e.g. https://abcd1234.ngrok.io/api/mpesa/callback) or
# your deployed domain in production.
MPESA_CALLBACK_URL=https://your-domain.example.com/api/mpesa/callback
