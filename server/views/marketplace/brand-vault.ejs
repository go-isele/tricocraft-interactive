<!DOCTYPE html>
<html lang="en">
<head><%- include('../partials/head') %></head>
<body>
<div class="dash">
  <%- include('../partials/dash-sidebar', { dashRole: 'client', dashActive: 'vault' }) %>
  <div class="dash-main">
    <%- include('../partials/dash-topbar') %>
    <div class="dash-content">
      <div class="dash-hd">
        <div><h1>Brand Vault</h1><p>Upload your logo, colours, fonts, and guidelines once — every order pulls from these approved assets.</p></div>
      </div>

      <div style="display:grid;grid-template-columns:1fr 1fr;gap:20px;margin-bottom:24px">
        <div class="card">
          <h3>Upload a File</h3>
          <form method="POST" action="/marketplace/brand-vault/upload" enctype="multipart/form-data">
            <div class="field">
              <label>Asset Type</label>
              <select name="asset_type">
                <option value="logo">Logo</option>
                <option value="guideline">Brand Guideline</option>
                <option value="font">Font</option>
                <option value="other">Other</option>
              </select>
            </div>
            <div class="field"><label>Label</label><input type="text" name="label" placeholder="e.g. Primary Logo — Full Colour"></div>
            <div class="field"><label>File</label><input type="file" name="file" required></div>
            <button class="btn btn-primary btn-block" type="submit">Upload</button>
          </form>
          <p style="font-size:11.5px;color:var(--slate-lt);margin-top:10px">Every upload runs a quick pre-press check automatically: resolution, likely colour space (RGB vs print-ready CMYK/vector), and a bleed reminder — flagged below each file.</p>
        </div>

        <div class="card">
          <h3>Add a Brand Colour</h3>
          <form method="POST" action="/marketplace/brand-vault/color">
            <div class="field"><label>Label</label><input type="text" name="label" placeholder="e.g. Primary Rust"></div>
            <div class="field"><label>Hex Code</label><input type="text" name="hex" placeholder="#C4451A" pattern="^#?[0-9A-Fa-f]{6}$" required></div>
            <button class="btn btn-dark btn-block" type="submit">Add Colour</button>
          </form>
        </div>
      </div>

      <div class="card">
        <h3>Vault Contents</h3>
        <% if (!assets.length) { %>
          <div class="empty-state"><div class="ico">◉</div><p>Nothing uploaded yet — add your logo and brand colours to get started.</p></div>
        <% } else { %>
          <div class="vault-grid">
            <% assets.forEach(a => { %>
              <div class="vault-tile">
                <form method="POST" action="/marketplace/brand-vault/<%= a.id %>/delete" onsubmit="return confirm('Remove this asset?')">
                  <button type="submit" title="Remove">✕</button>
                </form>
                <% if (a.asset_type === 'color_palette') { %>
                  <div class="swatch" style="background:<%= a.value %>"></div>
                <% } else { %>
                  <div class="swatch" style="display:flex;align-items:center;justify-content:center;background:var(--canvas)">📎</div>
                <% } %>
                <div class="name"><%= a.label %></div>
                <div class="type"><%= a.asset_type.replace('_',' ') %> <% if (a.verified) { %>· ✓ verified<% } %></div>
                <% if (a.likely_color_space) { %>
                  <div class="preflight-box">
                    <div class="dims"><%= a.likely_color_space %><%= a.width_px ? ' · ' + a.width_px + '×' + a.height_px + 'px' : '' %></div>
                    <% var notes = []; try { notes = JSON.parse(a.preflight_notes || '[]'); } catch (e) {} %>
                    <% if (notes.length) { %>
                      <ul>
                        <% notes.forEach(n => { %>
                          <li class="<%= /RGB/.test(n) ? 'warn-rgb' : (/resolution|DPI|low-resolution/.test(n) ? 'warn-res' : '') %>"><%= n %></li>
                        <% }) %>
                      </ul>
                    <% } %>
                  </div>
                <% } %>
              </div>
            <% }) %>
          </div>
        <% } %>
      </div>
    </div>
  </div>
</div>
</body>
</html>
