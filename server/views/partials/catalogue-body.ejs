<div class="cat-filter">
  <a href="/marketplace" class="<%= !activeCat ? 'active' : '' %>">All</a>
  <% categories.forEach(c => { %>
    <a href="/marketplace?category=<%= c.slug %>" class="<%= activeCat===c.slug?'active':'' %>"><%= c.icon %> <%= c.name %></a>
  <% }) %>
</div>

<% if (!products.length) { %>
  <div class="empty-state"><div class="ico">⊞</div><p>No products in this category yet.</p></div>
<% } else { %>
  <div class="product-grid">
    <% products.forEach(p => { %>
      <a class="product-card" href="/marketplace/product/<%= p.slug %>">
        <div class="thumb">
          <% if (p.image) { %><img src="<%= p.image %>" alt="<%= p.name %>">
          <% } else { %><%= (categories.find(c => c.id === p.category_id) || {}).icon || '▢' %><% } %>
        </div>
        <div class="body">
          <div class="cat"><%= p.category_name %></div>
          <h4><%= p.name %></h4>
          <div class="price"><%= fx.formatAmount(p.base_price, currency) %></div>
        </div>
      </a>
    <% }) %>
  </div>
<% } %>
