<header class="site-hdr">
  <div class="container row">
    <a href="/" class="brand">
      <img src="/static/img/triocraft-icon.svg" class="brand-mark" alt="TrioCraft">
      <div>
        <div class="brand-name">TrioCraft</div>
        <div class="brand-sub">Crafting Dreams, Forged in Brotherhood</div>
      </div>
    </a>
    <nav class="site-nav">
      <a href="/work" class="<%= path.startsWith('/work') ? 'active' : '' %>">Work</a>
      <a href="/services" class="<%= path.startsWith('/services') ? 'active' : '' %>">Services</a>
      <a href="/marketplace" class="<%= path.startsWith('/marketplace') ? 'active' : '' %>">Marketplace</a>
      <a href="/resources" class="<%= path.startsWith('/resources') ? 'active' : '' %>">Resources</a>
      <a href="/contact" class="<%= path === '/contact' ? 'active' : '' %>">Contact</a>
    </nav>
    <div class="hdr-actions">
      <%- include('currency-switcher') %>
      <a class="hdr-wa-link" href="<%= site.whatsappLink %>" target="_blank" rel="noopener" title="Chat on WhatsApp">
        <svg viewBox="0 0 32 32" width="18" height="18" fill="currentColor" aria-hidden="true"><path d="M16.02 3C9.4 3 4 8.36 4 15c0 2.34.64 4.53 1.75 6.4L3 29l7.8-2.68A11.9 11.9 0 0 0 16.02 27C22.63 27 28 21.64 28 15S22.63 3 16.02 3Z"/></svg>
      </a>
      <% if (currentUser) { %>
        <a class="hdr-user-pill" href="<%= currentUser.role === 'admin' ? '/admin' : currentUser.role === 'vendor' ? '/vendor' : '/marketplace' %>">
          <span class="hdr-av"><%= currentUser.name.charAt(0) %></span> <%= currentUser.name.split(' ')[0] %>
        </a>
      <% } else { %>
        <a class="btn btn-outline btn-sm" href="/login">Log In</a>
        <a class="btn btn-primary btn-sm" href="/register">Get Started</a>
      <% } %>
    </div>
  </div>
</header>
