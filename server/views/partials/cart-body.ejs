<% if (!items.length) { %>
  <div class="empty-state"><div class="ico">🛒</div><p>Your cart is empty.</p><br><a class="btn btn-primary" href="/marketplace">Browse the Catalogue →</a></div>
<% } else { %>
  <% if (guestError) { %><div class="form-error"><%= guestError %></div><% } %>
  <div class="card">
    <div class="table-wrap">
      <table>
        <thead><tr><th>Product</th><th>Options</th><th>Quantity</th><th>Unit Price</th><th>Line Total</th><th></th></tr></thead>
        <tbody>
          <% items.forEach((item, i) => { %>
            <tr>
              <td><%= item.product.name %><% if (item.brief) { %><div style="font-size:11.5px;color:var(--slate-lt)">"<%= item.brief %>"</div><% } %></td>
              <td style="font-size:12px;color:var(--slate-lt)">
                <% if (item.selections && item.selections.length) { %>
                  <% item.selections.forEach(s => { %><div><%= s.optionName %>: <%= s.valueLabel %></div><% }) %>
                <% } else { %>—<% } %>
              </td>
              <td><%= item.quantity %></td>
              <td><%= fx.formatAmount(item.unitPrice, currency) %><% if (item.tierApplied) { %><div style="font-size:10.5px;color:var(--forest)">volume rate</div><% } %></td>
              <td><%= fx.formatAmount(item.lineTotal, currency) %></td>
              <td>
                <form method="POST" action="/marketplace/cart/remove/<%= i %>">
                  <button class="btn btn-outline btn-sm" type="submit">Remove</button>
                </form>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
    <% if (currency !== 'KES') { %><p style="font-size:11px;color:var(--slate-lt);margin-top:10px">Prices shown in <%= currency %> for reference — you'll be charged the KES amount (via M-Pesa) or the regional-currency amount (via MoMo/Airtel Money).</p><% } %>
  </div>

  <% if (waLink) { %>
    <div class="card" style="display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:12px">
      <div style="font-size:13px;color:var(--ink-soft)">Want to negotiate pricing or ask a question before submitting?</div>
      <a class="wa-cta-outline" href="<%= waLink %>" target="_blank" rel="noopener">
        <svg viewBox="0 0 32 32" width="16" height="16" fill="currentColor" aria-hidden="true"><path d="M16.02 3C9.4 3 4 8.36 4 15c0 2.34.64 4.53 1.75 6.4L3 29l7.8-2.68A11.9 11.9 0 0 0 16.02 27C22.63 27 28 21.64 28 15S22.63 3 16.02 3Z"/></svg>
        Continue on WhatsApp
      </a>
    </div>
  <% } %>

  <div class="card">
    <form method="POST" action="/marketplace/cart/checkout" id="checkoutForm" enctype="multipart/form-data">
      <% if (!currentUser) { %>
        <div style="background:var(--canvas);border:0.5px solid var(--border-md);border-radius:var(--r-sm);padding:14px 16px;margin-bottom:18px">
          <div style="font-size:11.5px;font-weight:700;letter-spacing:.04em;text-transform:uppercase;color:var(--slate-lt);margin-bottom:10px">Your Details — so we can send your quotation</div>
          <div class="field"><label>Full Name</label><input type="text" name="guest_name" required></div>
          <div class="field"><label>Email</label><input type="email" name="guest_email" required></div>
          <div style="display:grid;grid-template-columns:1fr 1fr;gap:12px">
            <div class="field"><label>Company (optional)</label><input type="text" name="guest_company"></div>
            <div class="field"><label>Phone (optional)</label><input type="text" name="guest_phone"></div>
          </div>
        </div>
      <% } %>

      <div style="font-size:11.5px;font-weight:700;letter-spacing:.04em;text-transform:uppercase;color:var(--slate-lt);margin-bottom:10px">Delivery</div>
      <div class="delivery-options">
        <% (deliveryMethods || []).forEach((m, i) => { %>
          <label class="delivery-option<%= i===0 ? ' checked' : '' %>" data-delivery-option data-method="<%= m.value %>">
            <div class="hd">
              <input type="radio" name="delivery_method" value="<%= m.value %>" <%= i===0 ? 'checked' : '' %> data-cross-border="<%= m.value === 'cross_border_eac' %>">
              <span><%= m.label %></span>
            </div>
            <div class="partners">Partners: <%= m.partners.join(', ') %></div>
            <% if (m.value !== 'cross_border_eac' && m.partners.length > 1) { %>
              <select class="delivery-partner-select" name="delivery_partner">
                <% m.partners.forEach(p => { %><option value="<%= p %>"><%= p %></option><% }) %>
              </select>
            <% } %>
          </label>
        <% }) %>
      </div>
      <div style="display:grid;grid-template-columns:1fr 1fr;gap:12px">
        <div class="field"><label>Town / Area</label><input type="text" name="delivery_town" placeholder="e.g. Westlands, Nairobi"></div>
        <div class="field"><label>Delivery Address (optional)</label><input type="text" name="delivery_address" placeholder="Building, street, landmark"></div>
      </div>

      <div id="crossBorderBox" class="cross-border-box" style="display:none">
        <div style="font-weight:600;color:var(--ink);margin-bottom:8px">Cross-Border Destination</div>
        <div style="display:grid;grid-template-columns:1fr 1fr;gap:12px">
          <div class="field"><label>Destination Country</label>
            <select name="delivery_country">
              <% (eacCountries || []).filter(c => c.code !== 'KE').forEach(c => { %><option value="<%= c.code %>"><%= c.name %></option><% }) %>
            </select>
          </div>
          <div class="field"><label>Partner</label>
            <select name="delivery_partner">
              <% (crossBorderPartners || []).forEach(p => { %><option value="<%= p %>"><%= p %></option><% }) %>
            </select>
          </div>
        </div>
        <div class="field"><label>Approx. Parcel Weight (kg)</label><input type="number" name="parcel_weight_kg" value="1" min="0.1" step="0.1"></div>
        <p style="font-size:11px;color:var(--slate-lt)">Cross-border cost is a planning estimate — TrioCraft's logistics team will confirm the final rate with your assigned courier before dispatch.</p>
      </div>

      <% if (canUseCredit) { %>
        <div class="credit-terms-box">
          <div style="font-weight:600;color:var(--ink);margin-bottom:8px">Payment Terms <span class="corporate-pill">Corporate Account</span></div>
          <label class="opt"><input type="radio" name="payment_terms" value="due_on_delivery" checked> Pay now via M-Pesa / regional mobile money</label>
          <% [30,60,90].filter(d => d <= (creditTermsDays || 0)).forEach(d => { %>
            <label class="opt"><input type="radio" name="payment_terms" value="net<%= d %>"> Net <%= d %> days — invoice against an LPO</label>
          <% }) %>
          <div id="lpoFields" style="display:none;margin-top:10px">
            <div class="field"><label>LPO Number</label><input type="text" name="lpo_number" placeholder="e.g. LPO-2026-0451"></div>
            <div class="field"><label>Upload LPO Document (optional)</label><input type="file" name="lpo_document"></div>
          </div>
        </div>
      <% } %>

      <div style="display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:14px;margin-top:6px">
        <div>
          <div style="font-size:12.5px;color:var(--slate-lt)">Estimated Total</div>
          <div style="font-family:var(--display);font-size:26px"><%= fx.formatAmount(total, currency) %></div>
        </div>
        <button class="btn btn-primary" type="submit">Submit Order to TrioCraft →</button>
      </div>
    </form>
  </div>
  <p style="font-size:12px;color:var(--slate-lt)">Submitting creates one order per line item. TrioCraft's team will confirm the final quotation and assigned provider before production begins.</p>

  <script>
    document.querySelectorAll('[data-delivery-option]').forEach(function (label) {
      label.querySelector('input').addEventListener('change', function () {
        document.querySelectorAll('[data-delivery-option]').forEach(function (l) { l.classList.remove('checked'); });
        label.classList.add('checked');
        var crossBorderBox = document.getElementById('crossBorderBox');
        if (crossBorderBox) crossBorderBox.style.display = this.dataset.crossBorder === 'true' ? 'block' : 'none';
      });
    });
    document.querySelectorAll('input[name="payment_terms"]').forEach(function (input) {
      input.addEventListener('change', function () {
        var lpoFields = document.getElementById('lpoFields');
        if (lpoFields) lpoFields.style.display = this.value === 'due_on_delivery' ? 'none' : 'block';
      });
    });
  </script>
<% } %>
