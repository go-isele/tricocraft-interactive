<!DOCTYPE html>
<html lang="en">
<head><%- include('../partials/head', { metaDescription: post.meta_description }) %></head>
<body>
<%- include('../partials/site-header') %>

<main class="article-wrap">
  <div class="crumbs"><a href="/">Home</a> &nbsp;/&nbsp; <a href="/resources">Resources</a> &nbsp;/&nbsp; <%= post.title %></div>
  <div class="hero" style="padding:0;background:none">
    <div class="eyebrow"><%= post.eyebrow %></div>
  </div>
  <h1 class="article-title"><%= post.title %></h1>
  <div class="article-meta">
    <span>TrioCraft Brands Ltd</span>
    <span>·</span>
    <span><%= new Date(post.published_at).toLocaleDateString('en-KE', { year:'numeric', month:'long', day:'numeric' }) %></span>
    <span>·</span>
    <span><%= post.read_minutes %> min read</span>
  </div>

  <div class="article-body"><%- post.body_html %></div>

  <div class="cta-band" style="margin-top:48px">
    <h3>Crafting Dreams, Forged in Brotherhood.</h3>
    <p>Ready to start? Activate your Production Marketplace access and set up your Brand Vault today.</p>
    <a class="btn btn-primary" href="/register">Request Access →</a>
  </div>
</main>

<% if (related && related.length) { %>
<section class="section" style="padding-top:0">
  <div class="container">
    <h3 style="font-size:22px;margin-bottom:18px">More from Resources</h3>
    <div class="blog-grid">
      <% related.forEach(p => { %>
        <a class="blog-card" href="/resources/<%= p.slug %>">
          <div class="thumb">▢</div>
          <div class="body">
            <span class="tag"><%= p.eyebrow %></span>
            <h4><%= p.title %></h4>
            <p><%= p.excerpt %></p>
          </div>
        </a>
      <% }) %>
    </div>
  </div>
</section>
<% } %>

<%- include('../partials/site-footer') %>
<%- include('../partials/whatsapp-float') %>
</body>
</html>
