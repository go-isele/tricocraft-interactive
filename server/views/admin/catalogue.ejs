<!DOCTYPE html>
<html lang="en">
<head><%- include('../partials/head') %></head>
<body>
<div class="dash">
  <%- include('../partials/dash-sidebar', { dashRole: 'admin', dashActive: 'catalogue' }) %>
  <div class="dash-main">
    <%- include('../partials/dash-topbar') %>
    <div class="dash-content">
      <div class="dash-hd"><div><h1>Catalogue &amp; Providers</h1><p>Manage the products clients can order, their print pricing engine, and the vetted network that fulfils them.</p></div></div>

      <div style="display:grid;grid-template-columns:1fr 1fr;gap:20px;margin-bottom:20px">
        <div class="card">
          <h3>Add Product</h3>
          <form method="POST" action="/admin/catalogue/products/add">
            <div class="field"><label>Name</label><input type="text" name="name" required></div>
            <div class="field"><label>Category</label>
              <select name="category_id" required>
                <% categories.forEach(c => { %><option value="<%= c.id %>"><%= c.name %></option><% }) %>
              </select>
            </div>
            <div class="field"><label>Description</label><textarea name="description"></textarea></div>
            <div style="display:grid;grid-template-columns:1fr 1fr;gap:12px">
              <div class="field"><label>Base Price (KES)</label><input type="number" name="base_price" required></div>
              <div class="field"><label>Min Quantity</label><input type="number" name="min_quantity" value="1"></div>
            </div>
            <button class="btn btn-primary btn-block" type="submit">Add Product</button>
          </form>
        </div>

        <div class="card">
          <h3>Add Provider</h3>
          <form method="POST" action="/admin/catalogue/providers/add">
            <div class="field"><label>Name</label><input type="text" name="name" required></div>
            <div class="field"><label>Primary Category</label>
              <select name="category_id">
                <% categories.forEach(c => { %><option value="<%= c.id %>"><%= c.name %></option><% }) %>
              </select>
            </div>
            <div style="display:grid;grid-template-columns:1fr 1fr;gap:12px">
              <div class="field"><label>Turnaround (days)</label><input type="number" name="turnaround_days" value="7"></div>
              <div class="field"><label>Location</label><input type="text" name="location" value="Nairobi, Kenya"></div>
            </div>
            <div class="field"><label>Specialty</label><input type="text" name="specialty" placeholder="e.g. Screen Printing, Large Format Vinyl, Offset Litho"></div>
            <div class="field"><label>Notes</label><textarea name="notes"></textarea></div>
            <button class="btn btn-dark btn-block" type="submit">Add Provider</button>
          </form>
        </div>
      </div>

      <div class="card">
        <h3>Products &amp; Pricing Engine</h3>
        <% products.forEach(p => { %>
          <div class="pe-block" style="border-top:none;padding-top:0;margin-top:0;margin-bottom:28px;padding-bottom:24px;border-bottom:0.5px solid var(--border-md)">
            <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:10px">
              <div><strong><%= p.name %></strong> <span style="color:var(--slate-lt);font-size:12.5px">· <%= p.category_name %> · KES <%= p.base_price.toLocaleString() %> base · min <%= p.min_quantity %></span></div>
              <form method="POST" action="/admin/catalogue/products/<%= p.id %>/delete" onsubmit="return confirm('Deactivate this product?')">
                <button class="btn btn-outline btn-sm" type="submit"><%= p.active ? 'Deactivate' : 'Inactive' %></button>
              </form>
            </div>

            <div class="pe-block">
              <h5>Option Groups (e.g. Paper Stock, Finish, Size)</h5>
              <% if (!p.options.length) { %><p style="font-size:12px;color:var(--slate-lt);margin-bottom:10px">No option groups yet.</p><% } %>
              <% p.options.forEach(opt => { %>
                <div style="margin-bottom:10px">
                  <div style="font-size:12.5px;font-weight:600;margin-bottom:6px">
                    <%= opt.name %>
                    <form method="POST" action="/admin/catalogue/options/<%= opt.id %>/delete" style="display:inline" onsubmit="return confirm('Delete this option group and all its values?')">
                      <button class="btn btn-outline btn-sm" type="submit" style="padding:2px 10px;font-size:10.5px">Delete Group</button>
                    </form>
                  </div>
                  <div class="pe-list">
                    <% opt.values.forEach(v => { %>
                      <span class="pe-chip"><%= v.label %> <%= v.price_delta ? (v.price_delta > 0 ? '+' : '') + 'KES ' + v.price_delta.toLocaleString() : '' %><% if (v.is_default) { %> · default<% } %></span>
                    <% }) %>
                  </div>
                  <form method="POST" action="/admin/catalogue/options/<%= opt.id %>/values/add" class="pe-inline-form">
                    <input type="text" name="label" placeholder="Value label (e.g. 300gsm Matte)" required>
                    <input type="number" name="price_delta" placeholder="Price delta (KES)" value="0" style="width:150px">
                    <label style="font-size:11.5px;color:var(--slate-lt);display:flex;align-items:center;gap:4px"><input type="checkbox" name="is_default" value="1" style="width:auto"> default</label>
                    <button class="btn btn-outline btn-sm" type="submit">+ Add Value</button>
                  </form>
                </div>
              <% }) %>
              <form method="POST" action="/admin/catalogue/products/<%= p.id %>/options/add" class="pe-inline-form" style="margin-top:8px">
                <input type="text" name="name" placeholder="New option group name (e.g. Paper Stock)" required>
                <button class="btn btn-dark btn-sm" type="submit">+ Add Option Group</button>
              </form>
            </div>

            <div class="pe-block">
              <h5>Quantity Tiers (volume pricing)</h5>
              <% if (!p.tiers.length) { %><p style="font-size:12px;color:var(--slate-lt);margin-bottom:10px">No volume tiers yet — the base price applies at every quantity.</p><% } %>
              <div class="pe-list">
                <% p.tiers.forEach(t => { %>
                  <span class="pe-chip">
                    <%= t.min_qty %><%= t.max_qty ? '–' + t.max_qty : '+' %> units = KES <%= t.unit_price.toLocaleString() %>
                    <form method="POST" action="/admin/catalogue/tiers/<%= t.id %>/delete" style="display:inline">
                      <button type="submit">✕</button>
                    </form>
                  </span>
                <% }) %>
              </div>
              <form method="POST" action="/admin/catalogue/products/<%= p.id %>/tiers/add" class="pe-inline-form">
                <input type="number" name="min_qty" placeholder="Min qty" required style="width:100px">
                <input type="number" name="max_qty" placeholder="Max qty (blank = open-ended)" style="width:180px">
                <input type="number" name="unit_price" placeholder="Unit price (KES)" required style="width:150px">
                <button class="btn btn-outline btn-sm" type="submit">+ Add Tier</button>
              </form>
            </div>
          </div>
        <% }) %>
      </div>

      <div class="card">
        <h3>Providers</h3>
        <div class="table-wrap">
          <table>
            <thead><tr><th>Name</th><th>Category</th><th>Specialty</th><th>Turnaround</th><th>Location</th><th>Rating</th></tr></thead>
            <tbody>
              <% providers.forEach(p => { %>
                <tr><td><%= p.name %></td><td><%= p.category_name || '—' %></td><td><%= p.specialty || '—' %></td><td><%= p.turnaround_days %> days</td><td><%= p.location %></td><td>★ <%= p.rating %></td></tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      </div>
    </div>
  </div>
</div>
</body>
</html>
