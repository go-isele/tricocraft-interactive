<!DOCTYPE html>
<html lang="en">
<head><%- include('../partials/head') %></head>
<body>
<div class="dash">
  <%- include('../partials/dash-sidebar', { dashRole: 'admin', dashActive: 'orders' }) %>
  <div class="dash-main">
    <%- include('../partials/dash-topbar') %>
    <div class="dash-content">
      <div class="crumbs" style="margin-bottom:18px"><a href="/admin/orders">All Orders</a> &nbsp;/&nbsp; Order #<%= order.id %></div>
      <div class="dash-hd">
        <div><h1><%= order.title %></h1><p><%= order.client_company || order.client_name %> · <%= order.client_email %><% if (order.client_account_type === 'corporate') { %><span class="corporate-pill">Corporate<%= order.client_corporate_verified ? '' : ' (unverified)' %></span><% } %></p></div>
        <span class="badge badge-<%= order.status %>" style="font-size:13px;padding:6px 16px"><%= STATUS_LABELS[order.status] %></span>
      </div>

      <div style="display:grid;grid-template-columns:1fr 1.4fr;gap:20px">
        <div class="card">
          <h3>Manage Order</h3>
          <form method="POST" action="/admin/orders/<%= order.id %>/update">
            <div class="field">
              <label>Status</label>
              <select name="status">
                <% Object.entries(STATUS_LABELS).forEach(([k,v]) => { %>
                  <option value="<%= k %>" <%= order.status===k?'selected':'' %>><%= v %></option>
                <% }) %>
              </select>
            </div>
            <div class="field">
              <label>Provider</label>
              <select name="provider_id">
                <option value="">— Unassigned —</option>
                <% providers.forEach(p => { %>
                  <option value="<%= p.id %>" <%= order.provider_id===p.id?'selected':'' %>><%= p.name %><%= p.specialty ? ' — ' + p.specialty : '' %></option>
                <% }) %>
              </select>
            </div>
            <div class="field"><label>Quoted Unit Price (KES)</label><input type="number" name="quoted_price" value="<%= order.quoted_price || '' %>"></div>
            <div class="field">
              <label>Payment Status</label>
              <select name="payment_status">
                <option value="unpaid" <%= order.payment_status==='unpaid'?'selected':'' %>>Unpaid</option>
                <option value="deposit" <%= order.payment_status==='deposit'?'selected':'' %>>Deposit Paid</option>
                <option value="paid" <%= order.payment_status==='paid'?'selected':'' %>>Paid in Full</option>
                <option value="refunded" <%= order.payment_status==='refunded'?'selected':'' %>>Refunded</option>
              </select>
            </div>

            <div style="font-size:11.5px;font-weight:700;letter-spacing:.04em;text-transform:uppercase;color:var(--slate-lt);margin:18px 0 10px">Delivery</div>
            <div class="field">
              <label>Method</label>
              <select name="delivery_method">
                <option value="">— Not set —</option>
                <% DELIVERY_METHODS.forEach(m => { %>
                  <option value="<%= m.value %>" <%= order.delivery_method===m.value?'selected':'' %>><%= m.label %></option>
                <% }) %>
              </select>
            </div>
            <div class="field"><label>Partner</label><input type="text" name="delivery_partner" value="<%= order.delivery_partner || '' %>" placeholder="e.g. Sendy, EASY COACH, In-house Rider"></div>
            <div style="display:grid;grid-template-columns:1fr 1fr;gap:12px">
              <div class="field"><label>Town</label><input type="text" name="delivery_town" value="<%= order.delivery_town || '' %>"></div>
              <div class="field"><label>Address</label><input type="text" name="delivery_address" value="<%= order.delivery_address || '' %>"></div>
            </div>

            <div class="field"><label>Timeline Note (optional)</label><textarea name="note" placeholder="Add context for the client, e.g. quote details or a delay reason"></textarea></div>
            <button class="btn btn-primary btn-block" type="submit">Save Changes</button>
          </form>
        </div>

        <div>
          <div class="card">
            <h3>Order Details</h3>
            <div style="font-size:13.5px;line-height:2">
              <% if (category) { %>
                <div style="display:flex;justify-content:space-between"><span style="color:var(--slate-lt)">Service Category</span><span><span class="cat-code-pill"><%= category.service_code %></span> <%= category.name %></span></div>
              <% } %>
              <div style="display:flex;justify-content:space-between"><span style="color:var(--slate-lt)">Quantity</span><span><%= order.quantity %></span></div>
              <div style="display:flex;justify-content:space-between"><span style="color:var(--slate-lt)">Deadline</span><span><%= order.deadline || '—' %></span></div>
              <div style="display:flex;justify-content:space-between"><span style="color:var(--slate-lt)">Submitted</span><span><%= new Date(order.created_at).toLocaleString('en-KE') %></span></div>
              <% if (order.calculated_unit_price) { %>
                <div style="display:flex;justify-content:space-between"><span style="color:var(--slate-lt)">Pricing-engine estimate</span><span>KES <%= order.calculated_unit_price.toLocaleString() %> / unit</span></div>
              <% } %>
            </div>
            <% if (order.brief) { %><div style="margin-top:14px;font-size:13px;color:var(--slate-lt)"><strong>Brief:</strong> <%= order.brief %></div><% } %>
            <% if (order.mockup_filename) { %>
              <div style="margin-top:14px">
                <div style="font-size:11.5px;font-weight:700;letter-spacing:.04em;text-transform:uppercase;color:var(--slate-lt);margin-bottom:8px">Logo Placement Preview</div>
                <a href="/uploads/mockups/<%= order.mockup_filename %>" target="_blank" rel="noopener">
                  <img src="/uploads/mockups/<%= order.mockup_filename %>" alt="Logo placement preview" style="max-width:200px;border-radius:var(--r-sm);border:0.5px solid var(--border-md)">
                </a>
              </div>
            <% } %>
            <% if (aiBrief) { %>
              <div class="ai-brief-summary" style="margin-top:14px">
                <span class="tag"><%= aiBrief.method === 'ai' ? 'AI-Structured Brief' : 'Structured Brief' %></span>
                <% if (aiBrief.dimensions) { %><div><strong>Dimensions:</strong> <%= aiBrief.dimensions %></div><% } %>
                <div><strong>Colour mode:</strong> <%= aiBrief.colorMode %></div>
                <% if (aiBrief.placementNotes && aiBrief.placementNotes.length) { %><ul><% aiBrief.placementNotes.forEach(n => { %><li><%= n %></li><% }) %></ul><% } %>
              </div>
            <% } %>
            <% if (options && options.length) { %>
              <div style="margin-top:14px">
                <div style="font-size:11.5px;font-weight:700;letter-spacing:.04em;text-transform:uppercase;color:var(--slate-lt);margin-bottom:8px">Configuration</div>
                <% options.forEach(o => { %>
                  <div style="display:flex;justify-content:space-between;font-size:13px;padding:3px 0"><span style="color:var(--slate-lt)"><%= o.optionName %></span><span><%= o.valueLabel %></span></div>
                <% }) %>
              </div>
            <% } %>
          </div>

          <div class="card">
            <h3>Billing &amp; Invoicing</h3>
            <div style="font-size:13px;line-height:2">
              <div style="display:flex;justify-content:space-between"><span style="color:var(--slate-lt)">Payment Terms</span><span><%= order.payment_terms === 'due_on_delivery' ? 'Due on delivery' : order.payment_terms.replace('net', 'Net ') + ' days' %></span></div>
              <% if (order.lpo_number) { %><div style="display:flex;justify-content:space-between"><span style="color:var(--slate-lt)">LPO No.</span><span><%= order.lpo_number %><% if (order.lpo_filename) { %> · <a href="/uploads/lpo/<%= order.lpo_filename %>" target="_blank">view document</a><% } %></span></div><% } %>
              <div style="display:flex;justify-content:space-between"><span style="color:var(--slate-lt)">Invoice</span><span class="badge badge-<%= order.invoice_status %>"><%= order.invoice_status.replace('_',' ') %></span></div>
              <% if (order.invoice_number) { %><div style="display:flex;justify-content:space-between"><span style="color:var(--slate-lt)">Invoice No.</span><span><%= order.invoice_number %></span></div><% } %>
              <% if (order.invoice_due_date) { %><div style="display:flex;justify-content:space-between"><span style="color:var(--slate-lt)">Due Date</span><span><%= order.invoice_due_date %></span></div><% } %>
              <div style="display:flex;justify-content:space-between"><span style="color:var(--slate-lt)">KRA e-TIMS</span><span class="badge badge-<%= order.etims_status %>"><%= order.etims_status.replace('_',' ') %></span></div>
            </div>
            <div style="display:flex;gap:8px;margin-top:12px;flex-wrap:wrap">
              <% if (order.invoice_status === 'not_invoiced') { %>
                <form method="POST" action="/admin/orders/<%= order.id %>/invoice" onsubmit="return confirm('Issue a formal invoice for this order? This notifies the client by email and WhatsApp.')">
                  <button class="btn btn-dark btn-sm" type="submit">Issue Invoice</button>
                </form>
              <% } %>
              <a class="btn btn-outline btn-sm" href="/marketplace/orders/<%= order.id %>/invoice.pdf" target="_blank">📄 Download PDF</a>
            </div>
          </div>

          <div class="card">
            <h3>Payments</h3>
            <% if (!payments.length) { %>
              <p style="font-size:13px;color:var(--slate-lt)">No payment attempts recorded yet.</p>
            <% } else { %>
              <% payments.forEach(p => { %>
                <div class="pay-row">
                  <div>
                    <div style="font-size:13.5px;font-weight:600"><%= p.currency || 'KES' %> <%= p.amount.toLocaleString() %> · <%= p.method.toUpperCase() %><% if (p.phone) { %> · <%= p.phone %><% } %></div>
                    <div class="meta"><%= new Date(p.created_at).toLocaleString('en-KE') %><% if (p.mpesa_receipt) { %> · Receipt: <%= p.mpesa_receipt %><% } %><% if (p.result_desc) { %> · <%= p.result_desc %><% } %></div>
                  </div>
                  <span class="badge badge-<%= p.status %>"><%= p.status %></span>
                </div>
              <% }) %>
            <% } %>
          </div>

          <div class="card">
            <h3>Timeline</h3>
            <div class="timeline">
              <% timeline.forEach(t => { %>
                <div class="item">
                  <div class="stage"><%= t.stage %></div>
                  <% if (t.notes) { %><div class="notes"><%= t.notes %></div><% } %>
                  <div class="when"><%= new Date(t.created_at).toLocaleString('en-KE') %></div>
                </div>
              <% }) %>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
</body>
</html>
