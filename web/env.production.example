# Copy this to `.env.production.local` (note the leading dot) before running
# `npm run build` in production. Next.js inlines NEXT_PUBLIC_* values into the
# client bundle AT BUILD TIME, so this file must be in place *before* you
# build, not just before you start the server — see README-DEPLOY.md.
#
# `.env.production.local` matches the `.env*` pattern in .gitignore, so it
# will never be committed. This `env.production.example` file (no leading
# dot) is the one that is committed, as a template.

# Server Components fetch the API directly on the same machine — this stays
# as the Express app's internal port regardless of the public domain.
INTERNAL_API_URL=http://localhost:4000

# MUST be an explicit empty string in production — NOT omitted, NOT a URL.
# Both apps sit behind the same Nginx host (see README-DEPLOY.md), so an
# empty base means client-side fetches resolve relative to the page's own
# origin (e.g. https://your-domain.example/api/...), which Nginx then proxies
# to the Express app on :4000. Leaving this var unset would silently fall
# back to http://localhost:4000, which breaks in every visitor's browser —
# see the comment in lib/api.js for why `||` can't be used here.
NEXT_PUBLIC_API_URL=
